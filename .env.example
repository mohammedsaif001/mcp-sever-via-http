# Copy to .env and fill in. .env is git-ignored.
PORT=3000

# DeepWiki (free, no auth)
DEEPWIKI_MCP_URL=https://mcp.deepwiki.com/mcp

# Dynamics 365 Commerce MCP
D365_MCP_URL=<your-d365-mcp-url>
# Your online store's channel RecordId (Commerce headquarters > Channels > Online stores).
# Used when a /d365/tools/:name or /d365/chat request body has no channelId.
D365_CHANNEL_ID=<your-channel-id>

# OpenAI (used by POST /d365/chat via the OpenAI Agents SDK)
OPENAI_API_KEY=<your-openai-api-key>
# Optional: override the Agents SDK's default model
# OPENAI_MODEL=

# --- Signed-in D365 customer (optional) ---
# Needed for order history / account tools (search_orders etc. return 401 without it).
# The customer's sign-in token from your store's identity provider (Azure AD B2C / Entra External ID).
# Paste the raw token only (no prefix; the app sends it as "Authorization: Bearer <token>"). Only Bearer is accepted by Commerce. Tokens expire (~1 hour), so refresh when you get 401s.
D365_CUSTOMER_TOKEN=
# Passed to the AI in the system prompt and auto-filled into matching tool arguments.
D365_CUSTOMER_ACCOUNT_NUMBER=
D365_CUSTOMER_EMAIL=
D365_CUSTOMER_NAME=
# Default address for update_cart_address (state = short code e.g. WA, country = 3-letter ISO e.g. USA)
D365_CUSTOMER_STREET=
D365_CUSTOMER_CITY=
D365_CUSTOMER_STATE=
D365_CUSTOMER_ZIP=
D365_CUSTOMER_COUNTRY=
