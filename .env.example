# Copy to .env and fill in. .env is git-ignored.
PORT=3000

# DeepWiki (free, no auth)
DEEPWIKI_MCP_URL=https://mcp.deepwiki.com/mcp

# Dynamics 365 Commerce MCP
D365_MCP_URL=<your-d365-mcp-url>
# Your online store's channel RecordId (Commerce headquarters > Channels > Online stores).
# Used when a /d365/tools/:name or /d365/chat request body has no channelId.
D365_CHANNEL_ID=<your-channel-id>

# OpenAI (used by POST /d365/chat via the OpenAI Agents SDK)
OPENAI_API_KEY=<your-openai-api-key>
# Optional: override the Agents SDK's default model
# OPENAI_MODEL=
